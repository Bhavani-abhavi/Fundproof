# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Kaggle (needed for the Lending Club download). Uncomment ONE option and fill it in.
# Option A: generate an API token at https://www.kaggle.com/settings/api ("Generate New Token").
# KAGGLE_API_TOKEN=
# Option B: a legacy API key (the username and key from kaggle.json).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# If you keep kaggle.json in ~/.kaggle or ~/.config/kaggle instead, leave these commented out.

# LLM provider for document extraction and memos (Phase 2+): anthropic, openai, or fake (offline, for tests).
UWC_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override for the provider above. Defaults: claude-haiku-5-5 (anthropic), gpt-6-luna (openai).
# Every model you use needs a verified price in config/llm_pricing.yaml, or paid calls are refused.
UWC_LLM_MODEL=
# Base URLs are read ONLY from these project variables (never from ANTHROPIC_BASE_URL / OPENAI_BASE_URL).
UWC_ANTHROPIC_BASE_URL=https://api.anthropic.com
UWC_OPENAI_BASE_URL=https://api.openai.com/v1
# Effort for Anthropic requests: low (default), medium, high, xhigh or max. Thinking tokens count toward max_tokens.
# UWC_ANTHROPIC_EFFORT=low
# Where cached LLM responses are kept (default .cache/llm) and the verified price list (default config/llm_pricing.yaml).
# UWC_LLM_CACHE_DIR=.cache/llm
# UWC_LLM_PRICING_FILE=config/llm_pricing.yaml

# Hard cost cap in USD for any single run (ground rule 4).
MAX_RUN_COST_USD=10

# ---- Optional services. Everything below is commented out: the defaults work offline. ----

# Vector index (RAG). Unset UWC_QDRANT_URL = embedded Qdrant in the folder UWC_QDRANT_PATH (default qdrant_storage/).
# UWC_QDRANT_URL=http://localhost:6333
# UWC_QDRANT_API_KEY=
# UWC_QDRANT_PATH=qdrant_storage
# UWC_QDRANT_COLLECTION=uwc_guidelines

# Risk scoring REST service, shared by the agent and the MCP server. This is the service's BASE URL: every client
# sends POST <base URL>/score (do not add /score yourself; a value ending in /score is refused). Unset = the
# score_risk tool reports itself unavailable and nothing is sent anywhere. Timeout in seconds (default 10, max 120).
# UWC_RISK_API_URL=http://localhost:8000
# UWC_RISK_API_TIMEOUT_S=10

# Agent state: LangGraph checkpoint database (default .cache/agent/checkpoints.sqlite) and the append-only decision
# log (default data/processed/agent/decision_records.jsonl).
# UWC_AGENT_DB=.cache/agent/checkpoints.sqlite
# UWC_DECISION_LOG=data/processed/agent/decision_records.jsonl

# OTLP/HTTP traces endpoint, for example a local Arize Phoenix. Unset = spans are created but not exported.
# UWC_OTLP_ENDPOINT=http://localhost:6006/v1/traces
