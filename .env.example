# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Kaggle API (needed for the Lending Club download).
# Create a token at https://www.kaggle.com/settings -> "Create New API Token".
KAGGLE_USERNAME=
KAGGLE_KEY=

# LLM provider for document extraction and memos (Phase 2+). Pick one.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hard cost cap in USD for any single run (ground rule 4).
MAX_RUN_COST_USD=10
