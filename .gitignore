# Data is downloaded by scripts and never committed.
data/*
!data/.gitkeep

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment tracking: MLflow SQLite store (mlruns.db) + artifacts (mlruns/). mlflow.db is MLflow's own default name.
mlruns/
mlartifacts/
mlruns.db
mlflow.db

# Trained models at the repo root (rebuilt by the training scripts)
/models/

# Lock and temporary files written while updating results/*.json
results/*.lock
results/*.tmp

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
